{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ai-hack-sekiari",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ai-hack-sekiari"
		}
	],
	// 手元の開発（next dev）は手元の模擬 D1 を使う。本番の D1 に入れるのは pnpm db:remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-hack-sekiari",
			"database_id": "b96b990e-54f4-420f-b3db-c6e7a52fa8b9",
			"migrations_dir": "migrations"
		}
	]
}