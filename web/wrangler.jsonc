{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ai-hack-v2",
  // 入口は OpenNext の組み立てた Worker（.open-next/worker.js）を包む web/worker.mjs（2026-09-26）。定期実行の
  // scheduled を足すため（OpenNext の公式の手順「Custom Worker」の形）。fetch はそのまま組み立てた Worker へ渡る。
  "main": "./worker.mjs",
  // 1日1回の定期実行（2026-09-26 本人選択）。Google で直した店の座標のうち連続30日を過ぎたものを必ず消す
  // （Service Specific Terms 6.3.1・lib/scheduled → usecases/googleUpkeep）。時刻は UTC の 18:00＝日本時間の 3:00
  // （客の少ない時間・AI判断）。⚠️ 公開を止めている間も、次に wrangler deploy したときから動き出す。
  "triggers": { "crons": ["0 18 * * *"] },
  "compatibility_date": "2026-09-21",
  // 公開は 2026-09-25 から止めてある（README の「6.1 今は止めてある」・2026-09-26 の本人の依頼）。
  // workers.dev の公開の道と、版ごとの下見の URL を出さない。これが無いと、次の wrangler deploy で公開が黙って戻る。
  // 再開するときは README 6.2 の手順で、公開の道（workers_dev を true に戻すか独自のドメイン）を決めてから変える。
  "workers_dev": false,
  "preview_urls": false,
  // enable_request_signal: 客が接続を切ったときに request.signal を鳴らす（2026-09-25 監査の指摘 設計-18）。
  // 取得のストリームは、切断（とストリームの cancel）で書きかけの紹介文の AI を止める（lib/usecases/streamOffers）。
  // ⚠️ OpenNext を通した Next の req.signal へこの合図が届くかは未実測。届かなくても、ストリームの cancel の側で止まる。
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // 1回の取得が D1 へ何度も往復する（店の一覧 → オファー → クーポン → 記録の書き込み）ので、
  // 客に一番近い端で動かすより、D1 の近くで動かした方が往復の分だけ縮む見込みで頼む。
  // ⚠️ 効果は未実測（2026-09-22）。Cloudflare 側が「近づけても縮まない」と判断した要求は
  //    そのまま端で処理されるので、外れても遅くはならない。実測できたら数字をここに書く。
  "placement": { "mode": "smart" },
  // 記録（Workers Logs）を有効にする（2026-09-25 監査の指摘 安全-03・設計-01）。本番の500や連打・AI の1日の上限に
  // 届いたこと（ai_daily_budget_reached）を、後からダッシュボードで追えるようにする。記録に個人データは載せない（要件27）。
  // 残すのはアプリの記録（lib/adapters/logger が決まった形で書く1行）だけ。呼び出しごとの記録（invocation logs）は切り、
  // URL の問い合わせ文字列も伏せる——`/api/customer/place?lat=…&lng=…` の客の座標と `/api/customer/place-suggest?q=…`
  // の打った場所の文字が、要求の URL ごと Workers Logs に残っていた（2026-09-26 のレビュー）。
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-hack-v2",
      "database_id": "09a71aee-5f9e-4733-b92e-275afa4cbc57"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PERMITS",
      "bucket_name": "ai-hack-v2-permits"
    }
  ],
  "vars": {
    "ORCAROUTER_MODEL": "orcarouter/ai-sekitori",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE98fYv_yiGU_Aa_",
    "VAPID_PUBLIC_KEY": "BLacCvDVdQI5_Rgb1DqHDa0m_K50tyQVp9ry6YNhaI_9nwnd77KWSmqO1Zmy5wIIecMDpSZid3sEp_AKjIeG7MI"
  }
}
