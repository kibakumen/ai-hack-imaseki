  },
  "dependencies": {
    "next": "16.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.5"
  }
}
