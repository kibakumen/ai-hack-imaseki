{
  "name": "ai-hack-v2-web",
  "private": true,
  "scripts": {
    "dev": "node scripts/make-app-icons.mjs && next dev",
    "build": "node scripts/make-app-icons.mjs && next build",
    "lint": "eslint .",
    "deploy": "node scripts/deploy-guard.mjs && opennextjs-cloudflare build && pnpm run migrate:remote && wrangler deploy",
